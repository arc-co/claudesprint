{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sprint.schema.json",
  "title": "Sprint Schema",
  "description": "Schema for sprint - a collection of issues for a specific spec",
  "type": "object",
  "required": ["schema_version", "spec_id", "spec_file", "issues", "config", "created_at", "metadata"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "spec_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier derived from spec file (e.g., SPEC_01)"
    },
    "spec_file": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the source spec file"
    },
    "description": {
      "type": "string",
      "description": "Sprint description"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "priority", "acceptance_criteria"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique identifier (lowercase, hyphens, numbers only)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "blocked"]
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": ["setup", "infrastructure", "feature", "api", "ui", "testing", "docs", "bugfix"]
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Specific, testable criteria for completion"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of issues that must complete before this one"
          },
          "notes": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "description": "Issue-specific execution gates. Inherits from sprint config if not set.",
            "properties": {
              "require_testing": {
                "type": "boolean",
                "description": "Whether testing steps are required for this issue"
              },
              "require_browser_qa": {
                "type": "boolean",
                "description": "Whether browser-validation step is required for this issue"
              }
            },
            "additionalProperties": false
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["timestamp", "action"],
              "properties": {
                "timestamp": { "type": "string", "format": "date-time" },
                "action": { "type": "string" },
                "session_id": { "type": "string" }
              }
            },
            "description": "Append-only history of status changes"
          }
        },
        "additionalProperties": false
      }
    },
    "config": {
      "type": "object",
      "required": ["require_testing", "require_browser_qa"],
      "properties": {
        "require_testing": {
          "type": "boolean",
          "default": true,
          "description": "Whether testing steps are required"
        },
        "require_browser_qa": {
          "type": "boolean",
          "default": false,
          "description": "Whether browser-validation step is required"
        }
      },
      "additionalProperties": false
    },
    "git_branch": {
      "type": ["string", "null"],
      "description": "Git branch for this sprint"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of sprint creation"
    },
    "last_modified": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last modification"
    },
    "metadata": {
      "type": "object",
      "required": ["total_issues", "pending", "in_progress", "completed"],
      "properties": {
        "total_issues": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "in_progress": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
