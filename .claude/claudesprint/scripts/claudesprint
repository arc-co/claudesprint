#!/usr/bin/env python3
"""ClaudeSprint - Main entry point.

This script replaces all previous bash scripts:
- loop.sh      -> claudesprint run
- init.sh      -> claudesprint init
- validate.sh  -> claudesprint validate
- notify.sh    -> claudesprint notify

Usage:
    claudesprint              # Run workflow (default)
    claudesprint run -n 10    # Max 10 iterations
    claudesprint init         # Initialize project
    claudesprint plan         # Run planning mode
    claudesprint status       # Show current status
    claudesprint reset        # Reset to initial state
    claudesprint step <name>  # Run specific step
    claudesprint validate     # Validate current_issue.json
    claudesprint notify <type> <msg>  # Send notification
"""

import os
import sys

# Add the claudesprint package to the path (src layout)
script_dir = os.path.dirname(os.path.abspath(__file__))
claudesprint_root = os.path.dirname(script_dir)  # .claude/claudesprint
src_dir = os.path.join(claudesprint_root, "src")
sys.path.insert(0, src_dir)

from claudesprint.cli import app

if __name__ == "__main__":
    app()
