{
  "test": {
    "command": "npm test",
    "timeout": 300,
    "working_dir": null,
    "env": {},
    "success_exit_codes": [0],
    "failure_patterns": [
      "FAIL",
      "failed",
      "Error:",
      "AssertionError",
      "TypeError",
      "ReferenceError"
    ],
    "success_patterns": [
      "passed",
      "✓",
      "PASS",
      "All tests passed"
    ]
  },
  "lint": {
    "command": "npm run lint",
    "timeout": 120,
    "working_dir": null,
    "env": {},
    "success_exit_codes": [0],
    "failure_patterns": [
      "error",
      "warning"
    ],
    "success_patterns": []
  },
  "typecheck": {
    "command": "npm run typecheck",
    "timeout": 120,
    "working_dir": null,
    "env": {},
    "success_exit_codes": [0],
    "failure_patterns": [
      "error TS",
      "Error:"
    ],
    "success_patterns": []
  },
  "build": {
    "command": "npm run build",
    "timeout": 300,
    "working_dir": null,
    "env": {},
    "success_exit_codes": [0],
    "failure_patterns": [
      "error",
      "Error:",
      "failed"
    ],
    "success_patterns": [
      "Successfully",
      "Built"
    ]
  },
  "validate": {
    "command": "npm run validate",
    "timeout": 600,
    "working_dir": null,
    "env": {},
    "success_exit_codes": [0],
    "failure_patterns": [
      "FAIL",
      "error",
      "Error:"
    ],
    "success_patterns": []
  }
}
