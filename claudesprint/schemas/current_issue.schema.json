{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "current_issue.schema.json",
  "title": "CurrentIssue Schema",
  "description": "Schema for current issue session context - replaces Handoff for sprint model",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "timestamp",
    "sprint_path",
    "issue_id",
    "chunk_type",
    "step",
    "goal",
    "next_action",
    "repo_state",
    "changes",
    "commands_run",
    "current_failures",
    "retry_count"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier (ISO timestamp/step format)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sprint_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the sprint.json file"
    },
    "issue_id": {
      "type": "string",
      "description": "ID of the current issue being worked on"
    },
    "issue_title": {
      "type": "string",
      "default": "",
      "description": "Title of the current issue (for display purposes)"
    },
    "chunk_type": {
      "type": "string",
      "enum": ["select", "implement", "test", "review", "fix", "complete"],
      "description": "Current chunk/phase of work"
    },
    "step": {
      "type": "string",
      "enum": [
        "select-issue",
        "read-docs",
        "implement",
        "write-tests",
        "run-tests",
        "fix-tests",
        "browser-validation",
        "code-review",
        "fix-code-review-issues",
        "update-docs",
        "stage-changes",
        "commit-changes",
        "complete-issue"
      ],
      "description": "Current granular workflow step"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "1-2 sentence description of the current goal"
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "description": "Single concrete instruction for the next session"
    },
    "repo_state": {
      "type": "object",
      "required": ["git_head", "dirty"],
      "properties": {
        "git_head": {
          "type": "string",
          "description": "Current git HEAD SHA"
        },
        "dirty": {
          "type": "boolean",
          "description": "Whether there are uncommitted changes"
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "summary"],
        "properties": {
          "path": { "type": "string" },
          "summary": { "type": "string" }
        }
      },
      "description": "Files changed in this session with brief summaries"
    },
    "commands_run": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Commands executed during the session"
    },
    "current_failures": {
      "type": "string",
      "description": "Current test/build failures (empty if none)"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of times the current step has been retried due to failures"
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Arbitrary context data for the session (assumptions, open_questions, external_docs_findings, etc.)"
    },
    "last_test_run_hash": {
      "type": "string",
      "default": "",
      "description": "Hash of code files at last successful test run (for skip logic)"
    },
    "cached_docs": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "default": {},
      "description": "Path -> content hash for documentation caching"
    }
  },
  "additionalProperties": false
}
